// Estado de la escena. El plugin ide inserta los deltas de la IA
// justo antes de FIN_ACCION. Sintaxis: paed/Frankly/docs/PAED.md
ACCION escena ES
    AMBIENTE
        cubo1: CUBO;
    PROCESO
        FONDO (color = #1a1a2e);
        CAMARA(posicion = (0,2,5), mirar = (0,0,0));

        CUBO  (nombre = cubo1, posicion = (0,0,0), color = #ff0000, tamano = (1,1,1));

        PLANO(nombre = suelo, posicion = (0,-1,0), color = #3a5f0b, tamano = (12,0.1,12));
CUBO(nombre = tronco, posicion = (0,0,0), color = #6b4423, tamano = (0.4,2,0.4), grupo = arbol);
CUBO(nombre = rama_izq, posicion = (-0.5,0.8,0), color = #6b4423, tamano = (0.7,0.15,0.15), grupo = arbol);
CUBO(nombre = rama_der, posicion = (0.5,0.9,0), color = #6b4423, tamano = (0.7,0.15,0.15), grupo = arbol);
ESFERA(nombre = copa_centro, posicion = (0,1.7,0), color = #2e7d32, radio = 0.95, grupo = arbol);
ESFERA(nombre = copa_izq, posicion = (-0.8,1.4,0.1), color = #388e3c, radio = 0.65, grupo = arbol);
ESFERA(nombre = copa_der, posicion = (0.8,1.5,-0.1), color = #388e3c, radio = 0.7, grupo = arbol);
ESFERA(nombre = copa_frente, posicion = (0.1,1.3,0.7), color = #43a047, radio = 0.6, grupo = arbol);
ESFERA(nombre = copa_atras, posicion = (-0.1,1.6,-0.7), color = #2e7d32, radio = 0.6, grupo = arbol);
ESFERA(nombre = copa_alta, posicion = (0,2.4,0), color = #43a047, radio = 0.55, grupo = arbol);
LUZ(nombre = sol, posicion = (4,6,4), tipo = puntual, intensidad = 1.2);

FIN_ACCION
