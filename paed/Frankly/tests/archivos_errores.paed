// Fixture de errores de archivos: cada linea del PROCESO tiene exactamente un
// error, igual que errores.paed.
//
// Este programa NO IMPRIME NADA: si el parser encuentra un error, no se ejecuta
// ni una instruccion. Analisis primero, ejecucion despues.
//
// El caso mas importante es el de ABRIR con un archivo sin declarar. LEER no
// puede detectarlo: si el primer argumento no esta declarado, LEER lo trata
// como consola A PROPOSITO, porque un escalar no necesita declararse
// (`LEER(salario)` sin declarar `salario` es legitimo). Por eso la red que
// atrapa el archivo olvidado es ABRIR, que si exige que exista.

ACCION archivos_errores ES
    AMBIENTE
        venta = REGISTRO
            monto: REAL;
        FIN_REGISTRO

        arch: ARCHIVO DE venta;
        otro: ARCHIVO DE venta;
        reg: venta;
        cantidad: ENTERO;
    PROCESO
        ABRIR(fantasma, lectura);
        ABRIR(cantidad, lectura);
        LEER(arch);
        ESCRIBIR(arch, reg, cantidad);
        LEER(arch, otro);
        LEER(Arch, reg);
FIN_ACCION
