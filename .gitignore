# Ignorar todo excepto lo listado abajo
/*
# paed/ y PseudoGames/ son SUBMODULOS, y hay que habilitarlos aca igual que
# cualquier otra carpeta: el '/*' de arriba ignora todo lo que no este en esta
# lista. Sin estas lineas, `git submodule add` responde "Use -f if you really
# want to add them", que suena a otro problema.
!/paed/
!/PseudoGames/
!/.gitignore
!/LICENSE
!/.github/

# Core del OS (userspace)
!/main.c
!/bus/
!/plugins/
!/cjson/
!/docs/
!/KANBAN.md
!/framebuffer.md
# Arnés de PAED: corre un .paed en la terminal, sin SDL
!/tools/
# Flags para clangd (Helix). Sin esto el editor marca todo el proyecto en rojo
!/compile_flags.txt

# Programas escritos EN PAED. No van en el repo del lenguaje: PAED no lleva
# adentro los programas que uno escribe con el, igual que Python no trae los
# scripts de nadie.
!/programas/

# Motor grafico 2D
!/engine/
!/game/
!/examples/

# Mazmorra ASCII con hot reload
!/hot-Reload/

# ── Los otros dos repos ─────────────────────────────────────────────────────
# paed/ y PseudoGames/ son SUBMODULOS: repos propios que viven adentro de esta
# carpeta. VimMon no versiona sus archivos, solo guarda a que commit de cada uno
# apunta (mira .gitmodules).
#
# En la otra PC, despues de clonar:
#
#     git submodule update --init
#
# o directamente:  git clone --recurse-submodules <url>
#
# Para traer lo ultimo de cada uno:  git submodule update --remote

# Aprendizaje y contenido personal
!/documentacion/
!/pizarronInfinito/
!/ejUno_V1/
!/src/
!/learnC/
!/_void/
!/CUDA/
!/ProyectoVimMon/

_void/*.tar.gz
ProyectoVimMon/.obsidian/

# Metadata Windows (Zone.Identifier)
*:Zone.Identifier

# Cache de tooling
bus/.atl/
