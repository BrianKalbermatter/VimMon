!/compile_flags.txt

# Motor grafico 2D
!/engine/
!/game/
!/examples/

# Mazmorra ASCII con hot reload
!/hot-Reload/

# ── PAED ────────────────────────────────────────────────────────────────────
# PAED es OTRO REPO, que vive adentro de esta carpeta. No esta trackeado aca a
# proposito: sus archivos los versiona `paed/.git`, no este repo.
#
# Todavia NO es un submodulo formal — le falta estar publicado. Cuando lo este:
#
#     git submodule add <url> paed
#
# y esta linea se borra, porque el submodulo se trackea como un puntero al
# commit. Hasta entonces queda ignorado, que es lo unico que evita que VimMon se
# lo vuelva a tragar entero.
#
# En la otra PC, despues de clonar: git submodule update --init
/paed/

# Lo mismo para el editor: PseudoGames es un TERCER repo. VimMon lo lanza pero
# no lo versiona — de hecho puede lanzar cualquier otro (VIMMON_IDE).
/PseudoGames/

# Aprendizaje y contenido personal
!/documentacion/
!/pizarronInfinito/
!/ejUno_V1/
!/src/
!/learnC/
!/_void/
!/CUDA/
!/ProyectoVimMon/

_void/*.tar.gz
ProyectoVimMon/.obsidian/

# Metadata Windows (Zone.Identifier)
*:Zone.Identifier

# Cache de tooling
bus/.atl/
