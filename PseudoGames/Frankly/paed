#!/bin/bash
source ./flags.sh
source ./validacion.sh
# paed - Interprete/Compilador del lenguaje .paed
# Uso: ./paed nombreArchivo.paed

ARCHIVO=$1

analizar(){
    echo "analizando..."
    # Mi logica es que tiene que ir linea por linea verificando la sintaxis
    if [ -z "$ARCHIVO" ]; # Verifica si es Verdadero, si la variable esta vacia (sin valor)
    then
        echo "Error: Esta vacio!"
        return 1
    fi

    if [ ! -f "$ARCHIVO" ]; # Verifica si un archivo existe
    then
        echo "Error: no existe el archivo"
        return 1
    fi
    
    if [ ${ARCHIVO##*.} == "paed" ]
    then
        echo "Bien!, es extension paed"

    else
        echo "Mal!, no es extension paed"
        return 1
    fi

    linea_num=0
    while read linea; do
        set -- $linea #divide la linea en $1 $2 $3...
        linea_num=$((linea_num + 1))
        

        #--------------------------------
        # Primera palabra de la linea
        #Este case le dice que existen estas variables

        case $1 in 
            ACCION) find_ACCION=1 ;;
            #MIENTRAS
            #FUNCION
        esac
        # Segunda palabra es una asignacion entonces para asignar a otra es la 2da ej: a:=b;
        case $2 in
            #*:=*) echo "$ARCHIVO:$linea_num: error: sintaxys ASIGNACION':='" ;;
        esac

        # $# es la cantidad de palabras en la linea para agarrar la ultima, necesitas eval
        eval last=\$$#
        # Todos los que van al final de las lineas
        case $last in
            ES) find_ES=1 ;;
            HACER) find_HACER=1 ;;
            ENTONCES) find_ENTONCES=1 ;;
        esac
        #--------------------------------

        #Lineas que van solas en sintaxis en la misma linea
        case $linea in
            
            AMBIENTE)
                if [ $find_ACCION -eq 1 ] && [ $find_AMBIENTE -eq 0 ]; 
                then
                    find_AMBIENTE=1
                else
                    echo "$ARCHIVO:$linea_num: error: sintaxys AMBIENTE"
                fi
                ;;

            PROCESO)
                if [ $find_ACCION -eq 1 ] && [ $find_AMBIENTE -eq 1 ] && [ $find_PROCESO -eq 0 ];
                then
                    find_PROCESO=1
                else
                    echo "$ARCHIVO:$linea_num: error: sintaxys PROCESO"
                fi
                ;;
            
            FIN_ACCION)
                if [ $find_ACCION -eq 1 ] && [ $find_FIN_ACCION -eq 0 ];
                then
                    find_FIN_ACCION=1
                else
                    echo "$ARCHIVO:$linea_num: error: sintaxys FIN_ACCION"
                fi
                ;;






            
            
            # Faltan otros pero por ahora probare con estos!
            
        esac
    done < "$ARCHIVO"

    validacion_end
}














ejecutar() {
    echo "ejecutando..."
    en_proceso=0
    declare -A variables
    set -f   # deshabilitar glob: el * en expresiones no expande archivos
    while read linea; do
        set -- $linea
        linea_num=$((linea_num + 1))
        case $linea in
            PROCESO) en_proceso=1 ;;
            FIN_ACCION) en_proceso=0 ;;
        esac
       
        if [[ $en_proceso -eq 1 ]];
        then
            case $2 in

                :=)
                    rhs="${@:3}"
                    rhs="${rhs%;}"
                    # Reemplazar variables conocidas por su valor
                    for var in "${!variables[@]}"; do
                        rhs="${rhs//$var/${variables[$var]}}"
                    done
                    # Intentar evaluar como expresion aritmetica con bc
                    # ^ es exponenciacion en bc, funciona directo
                    resultado=$(echo "scale=6; $rhs" | bc -l 2>/dev/null)
                    if [ $? -eq 0 ] && [ -n "$resultado" ]; then
                        variables[$1]=$resultado
                    else
                        # Es texto: quitar comillas
                        rhs="${rhs//\"/}"
                        variables[$1]=$rhs
                    fi
                     ;;
                "")
            
                nombre=${1#ESCRIBIR(}    # saca "ESCRIBIR(" del inicio → queda "mensaje);"
                nombre=${nombre%)*}      # saca ")" y lo de después    → queda "mensaje"
                echo ${variables[$nombre]}
                ;;
            esac
        fi
    done < "$ARCHIVO"
    set +f   # re-habilitar glob
}

# $1 = el archivo que le pasas como argumento
analizar 
if [ $? -eq 0 ]; 
then
    ejecutar
fi

